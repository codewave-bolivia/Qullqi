-- SMS codes issued to a phone during registration and PIN recovery (spec 002, FR-009..FR-011).

CREATE TABLE phone_confirmation (
  id TEXT NOT NULL PRIMARY KEY,
  phone TEXT NOT NULL CHECK (phone GLOB '+591[67][0-9][0-9][0-9][0-9][0-9][0-9][0-9]'),
  code TEXT NOT NULL CHECK (length(code) = 6 AND code NOT GLOB '*[^0-9]*'),
  issued_at INTEGER NOT NULL,
  expires_at INTEGER NOT NULL,
  tries_left INTEGER NOT NULL DEFAULT 3 CHECK (tries_left BETWEEN 0 AND 3),
  confirmed_at INTEGER,
  user_id TEXT REFERENCES user(id) ON DELETE CASCADE
);

CREATE INDEX phone_confirmation_phone ON phone_confirmation(phone, issued_at);
