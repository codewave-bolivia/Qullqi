-- Users, credentials, the single open session and terms acceptances (spec 002, data-model.md).

CREATE TABLE user (
  id TEXT NOT NULL PRIMARY KEY,
  full_name TEXT NOT NULL CHECK (length(trim(full_name)) > 0),
  phone TEXT NOT NULL UNIQUE CHECK (phone GLOB '+591[67][0-9][0-9][0-9][0-9][0-9][0-9][0-9]'),
  email TEXT NOT NULL,
  verification TEXT NOT NULL DEFAULT 'NOT_VERIFIED'
    CHECK (verification IN ('NOT_VERIFIED', 'UNDER_REVIEW', 'VERIFIED')),
  is_new INTEGER NOT NULL DEFAULT 1 CHECK (is_new IN (0, 1)),
  pin_attempts_left INTEGER NOT NULL DEFAULT 3 CHECK (pin_attempts_left BETWEEN 0 AND 3),
  created_at INTEGER NOT NULL
);

CREATE TABLE credential (
  user_id TEXT NOT NULL PRIMARY KEY REFERENCES user(id) ON DELETE CASCADE,
  pin_hash TEXT NOT NULL,
  pin_salt TEXT NOT NULL,
  iterations INTEGER NOT NULL CHECK (iterations >= 100000),
  updated_at INTEGER NOT NULL
);

-- At most one open session on the device: the table can only ever hold slot 1.
CREATE TABLE current_session (
  slot INTEGER NOT NULL PRIMARY KEY CHECK (slot = 1),
  user_id TEXT NOT NULL REFERENCES user(id) ON DELETE CASCADE,
  opened_at INTEGER NOT NULL
);

CREATE TABLE terms_acceptance (
  user_id TEXT NOT NULL REFERENCES user(id) ON DELETE CASCADE,
  terms_version TEXT NOT NULL,
  accepted_at INTEGER NOT NULL,
  PRIMARY KEY (user_id, terms_version)
);

-- Session (US1)

storedUsers:
SELECT id, full_name, phone, pin_attempts_left FROM user ORDER BY full_name;

credentialFor:
SELECT pin_hash, pin_salt, iterations FROM credential WHERE user_id = ?;

attemptsLeft:
SELECT pin_attempts_left FROM user WHERE id = ?;

decrementAttempts:
UPDATE user SET pin_attempts_left = max(pin_attempts_left - 1, 0) WHERE id = ?;

resetAttempts:
UPDATE user SET pin_attempts_left = 3 WHERE id = ?;

openSession:
INSERT OR REPLACE INTO current_session (slot, user_id, opened_at) VALUES (1, ?, ?);

closeSession:
DELETE FROM current_session;

currentSessionUserId:
SELECT user_id FROM current_session;

currentUser:
SELECT u.id, u.full_name, u.phone, u.email, u.verification
FROM current_session s JOIN user u ON u.id = s.user_id;

markNotNew:
UPDATE user SET is_new = 0 WHERE id = ?;

-- Registration and PIN reset (US2)

insertUser:
INSERT INTO user (id, full_name, phone, email, created_at) VALUES (?, ?, ?, ?, ?);

insertCredential:
INSERT INTO credential (user_id, pin_hash, pin_salt, iterations, updated_at) VALUES (?, ?, ?, ?, ?);

updateCredential:
UPDATE credential SET pin_hash = ?, pin_salt = ?, iterations = ?, updated_at = ? WHERE user_id = ?;

insertTerms:
INSERT INTO terms_acceptance (user_id, terms_version, accepted_at) VALUES (?, ?, ?);

userIdByPhone:
SELECT id FROM user WHERE phone = ?;

-- Verification (US3)

userVerification:
SELECT verification FROM user WHERE id = ?;
