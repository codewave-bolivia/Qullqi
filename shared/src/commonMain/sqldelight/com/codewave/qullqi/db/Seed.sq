-- Deterministic synthetic sample data (spec 002, data-model.md "Sample data").
-- Fictitious people, phones in +59170000xxx, emails @example.com. No real personal data.
-- Sample PIN for every user: 1234 (PBKDF2-HMAC-SHA256, 120000 iterations, fixed salt per user).
-- Run by SeededSchema.create and LocalDataReset.reset(withSamples = true).

insertSamples {
  INSERT INTO user (id, full_name, phone, email, verification, is_new, pin_attempts_left, created_at) VALUES
    ('usr-verified',   'Lucía Prueba Quispe',    '+59170000001', 'usr-verified@example.com',   'VERIFIED',     0, 3, 1767225600000),
    ('usr-unverified', 'Mateo Demo Choque',      '+59170000002', 'usr-unverified@example.com', 'NOT_VERIFIED', 0, 3, 1767225600000),
    ('usr-review',     'Valeria Ejemplo Mamani', '+59170000003', 'usr-review@example.com',     'UNDER_REVIEW', 0, 3, 1767225600000),
    ('usr-rejected',   'Diego Muestra Flores',   '+59170000004', 'usr-rejected@example.com',   'NOT_VERIFIED', 0, 3, 1767225600000),
    ('usr-locked',     'Sofía Ficticia Rojas',   '+59170000005', 'usr-locked@example.com',     'VERIFIED',     0, 0, 1767225600000),
    ('usr-new',        'Andrés Nuevo Condori',   '+59170000006', 'usr-new@example.com',        'NOT_VERIFIED', 1, 3, 1767225600000);

  INSERT INTO credential (user_id, pin_hash, pin_salt, iterations, updated_at) VALUES
    ('usr-verified',   'VRNzRXffI0GsPDHEjulVUPzojJ6+ZUFCvlkA/t+X+ec=', 'Fmh9rPjcxeuh0drNcorTsQ==', 120000, 1767225600000),
    ('usr-unverified', 'Mesb8qjbk1t15dB25ub+xPYHLpBEB4y300Jl/u5x0Co=', '4ZpIoU6eCarYWrgkfBtmOQ==', 120000, 1767225600000),
    ('usr-review',     'LDDqQBxCuSAjJSNtXJiaSQ89JCiC7k0g0WAtAWLpxJg=', 'tFBpsTafmhrab3OmWbw/Vw==', 120000, 1767225600000),
    ('usr-rejected',   'JqgJKy7CrpFcMfk4y8Vkl16KJzN5nfcVXqClvsoX5z0=', 'enihNXogXGuqoLGFBEA8Fg==', 120000, 1767225600000),
    ('usr-locked',     '6BqkxEHOzKMkZKfXWY6ngZqjzI8TC9d/lhjOx16x/r8=', '/kXN1RyAPN2tM1F8XqGNlQ==', 120000, 1767225600000),
